# MindGenome AI — Production-Grade Environment Configuration
# 12-factor: config via environment only. Never commit real secrets.

APP_ENV=local
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-64-char-random-string
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Auth & Passwords
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP & Transactional Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mindgenome.ai
SMTP_TLS=true

# PostgreSQL 16 (Relational Source of Truth with Row-Level Security)
DATABASE_URL=postgresql+asyncpg://mindgenome:mindgenome_secure_password_2026@localhost:5432/mindgenome
DATABASE_URL_SYNC=postgresql://mindgenome:mindgenome_secure_password_2026@localhost:5432/mindgenome

# Redis 7 (Cache, Sliding-Window Rate Limiting, Celery Broker)
REDIS_URL=redis://:redis_secure_password_2026@localhost:6379/0
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://:redis_secure_password_2026@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secure_password_2026@localhost:6379/2

# Neo4j 5 (Graph Structure & Directed Concept Prerequisite DAGs)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password_2026
NEO4J_DATABASE=neo4j

# Qdrant Vector Database (versioned cosine embedding collections)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mindgenome_chunks
EMBEDDING_COLLECTION_NAME=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_VERSION=gemini_embedding_001_v1
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=12
RAG_MIN_SIMILARITY_SCORE=0.35

# Gemini 2.5 Pro (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

# S3-Compatible Object Storage (AWS S3, MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniosecurepassword2026
S3_BUCKET_NAME=mindgenome-documents
S3_REGION=us-east-1

# Document Upload & Ingestion Caps
UPLOAD_MAX_BYTES=26214400
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=12
RETRIEVAL_MIN_SCORE=0.35
PREREQUISITE_CONFIDENCE_MIN=0.75

# Observability & Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
