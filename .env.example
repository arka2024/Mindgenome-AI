# MindGenome AI — copy to .env. Never commit real secrets.
# 12-factor: config via environment only. pydantic-settings in S1.

APP_ENV=local
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-64-char-random-string
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://mindgenome:mindgenome@localhost:5432/mindgenome
DATABASE_URL_SYNC=postgresql://mindgenome:mindgenome@localhost:5432/mindgenome

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mindgenome_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
# Verify the model id against Google AI Studio before S3. Do not guess in CI.

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=mindgenome-uploads
S3_REGION=us-east-1

# Uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Observability (optional in local)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Malware scan hook (no-op locally)
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_URL=

# Retrieval
RETRIEVAL_TOP_K=12
RETRIEVAL_MIN_SCORE=0.35
PREREQUISITE_CONFIDENCE_MIN=0.75
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
